---
import {awards,type Entry} from '../lib/content';
const entries=awards.entries as Entry[];
---
{entries.length?<div class="timeline">{entries.map(entry=><article><span class="date">{entry.date}</span><div><h3>{entry.title}</h3>{entry.institution&&<p>{entry.institution}</p>}{entry.description&&<p class="muted">{entry.description}</p>}</div></article>)}</div>:<p class="empty-inline">Honors and awards will be added here.</p>}