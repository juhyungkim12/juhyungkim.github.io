---
import type {Research} from '../lib/content';import {publications} from '../lib/content';import Media from './Media.astro';const {project:p,index}=Astro.props as {project:Research;index:number};const related=publications.filter(pub=>p.related?.includes(pub.id));
---
<section class="research-section" id={p.id}><div class="section-number">{String(index+1).padStart(2,'0')}</div><div class="research-body">{p.placeholder&&<p class="eyebrow muted">EXAMPLE RESEARCH AREA</p>}<h2>{p.title}</h2>{p.summary&&<p class="lead">{p.summary}</p>}<Media image={p.image} video={p.video} alt={p.alt} caption={p.caption}/>{(p.approach||p.results)&&<div class="research-copy">{p.approach&&<div><h3>Research approach</h3><p class="preserve">{p.approach}</p></div>}{p.results&&<div><h3>Key results</h3><p class="preserve">{p.results}</p></div>}</div>}{(p.media?.length??0)>0&&<div class="gallery">{p.media?.map(media=><Media {...media}/>)}</div>}{related.length>0&&<div><h3>Related publications</h3>{related.map(pub=><p><a href={'/publications/#'+pub.id}>{pub.title} ↗</a></p>)}</div>}</div></section>
