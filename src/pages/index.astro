---
import Layout from '../layouts/Layout.astro';import ProfileHero from '../components/ProfileHero.astro';import EducationList from '../components/EducationList.astro';import AwardsList from '../components/AwardsList.astro';import PublicationItem from '../components/PublicationItem.astro';import CVDownload from '../components/CVDownload.astro';import {publications} from '../lib/content';const selected=publications.filter(p=>p.featured).slice(0,3);
---
<Layout><ProfileHero/><section class="section"><p class="eyebrow">ACADEMIC BACKGROUND</p><h2>Education</h2><EducationList/><h2 class="subsection-heading">Honors &amp; Awards</h2><AwardsList/></section><section class="section"><div class="section-heading"><div><p class="eyebrow">ACADEMIC OUTPUT</p><h2>Selected publications</h2></div><a href="/publications/">All publications <span aria-hidden="true">↗</span></a></div>{selected.length?selected.map(publication=><PublicationItem publication={publication}/>):<div class="empty-state"><h3>Publications forthcoming</h3><p>Featured publications will appear here once bibliographic details are available.</p></div>}</section><CVDownload/></Layout>